# Copie para .env.local e preencha para usar o backend Supabase.
# Sem estas variáveis, o app funciona com um repositório local (localStorage)
# equivalente, útil para desenvolvimento e demonstração.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# E-mail que deve ser reconhecido como administrador (Seção 3).
# NUNCA coloque a senha da conta administradora aqui nem em nenhum arquivo do repositório.
VITE_ADMIN_EMAIL=felipe.cruz33@gmail.com

# ID do produto de assinatura no Google Play Billing (Seção 7).
VITE_PREMIUM_PRODUCT_ID=premium_mensal

# Chave da API do Gemini (aistudio.google.com/apikey, tem tier gratuito),
# usada só pela função serverless api/gerar-aula.ts — SEM prefixo VITE_ de
# propósito, pra nunca ser incluída no código enviado ao navegador. Funciona
# como uma chave "de fallback" compartilhada: cada usuário pode (e deve, pra
# não competir por cota) colocar a própria chave gratuita em "Perfil" — essa
# aqui só é usada por quem ainda não configurou a sua. Sem nenhuma das duas,
# "PDF com IA" fica indisponível com um erro claro (não falha silenciosamente).
GEMINI_API_KEY=

# Chave reserva opcional (mesmo tipo da acima, de uma segunda conta/projeto
# Google). Se a chave principal (a do usuário em "Perfil" ou GEMINI_API_KEY)
# devolver 503 "alta demanda" mesmo após tentar de novo, a função tenta essa
# automaticamente antes de desistir. Totalmente opcional — sem ela, o
# comportamento é o mesmo de antes.
GEMINI_API_KEY_RESERVA=
