# Copie para .env.local e preencha para usar o backend Supabase.
# Sem estas variáveis, o app funciona com um repositório local (localStorage)
# equivalente, útil para desenvolvimento e demonstração.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# E-mail que deve ser reconhecido como administrador (Seção 3).
# NUNCA coloque a senha da conta administradora aqui nem em nenhum arquivo do repositório.
VITE_ADMIN_EMAIL=felipe.cruz33@gmail.com

# ID do produto de assinatura no Google Play Billing (Seção 7).
VITE_PREMIUM_PRODUCT_ID=premium_mensal

# Chave da API da Anthropic (console.anthropic.com), usada só pela função
# serverless api/gerar-aula.ts — SEM prefixo VITE_ de propósito, pra nunca
# ser incluída no código enviado ao navegador. Sem esta variável, "PDF com
# IA" fica indisponível com um erro claro (não falha silenciosamente).
ANTHROPIC_API_KEY=
