# Copie para .env.local e preencha para usar o backend Supabase.
# Sem estas variáveis, o app funciona com um repositório local (localStorage)
# equivalente, útil para desenvolvimento e demonstração.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# E-mail que deve ser reconhecido como administrador (Seção 3).
# NUNCA coloque a senha da conta administradora aqui nem em nenhum arquivo do repositório.
VITE_ADMIN_EMAIL=felipe.cruz33@gmail.com

# ID do produto de assinatura no Google Play Billing (Seção 7).
VITE_PREMIUM_PRODUCT_ID=premium_mensal

# Chave da API do Gemini (aistudio.google.com/apikey, tem tier gratuito),
# usada só pela função serverless api/gerar-aula.ts — SEM prefixo VITE_ de
# propósito, pra nunca ser incluída no código enviado ao navegador. Funciona
# como uma chave "de fallback" compartilhada: cada usuário pode (e deve, pra
# não competir por cota) colocar a própria chave gratuita em "Perfil" — essa
# aqui só é usada por quem ainda não configurou a sua. Sem nenhuma das duas,
# "PDF com IA" fica indisponível com um erro claro (não falha silenciosamente).
GEMINI_API_KEY=

# Chave(s) reserva opcional(is) (mesmo tipo da acima, de outra(s) conta(s)/
# projeto(s) Google). Se a chave principal (a do usuário em "Perfil" ou
# GEMINI_API_KEY) devolver 429 "cota esgotada" ou 503 "alta demanda" mesmo
# após tentar de novo, a função tenta a(s) próxima(s) automaticamente antes
# de desistir. Aceita mais de uma chave: separe por vírgula ou quebra de
# linha (ex.: "chave1,chave2,chave3") — pra adicionar mais reservas basta
# colar outra chave aqui, sem precisar mexer no código. Totalmente opcional
# — sem ela, o comportamento é o mesmo de antes.
GEMINI_API_KEY_RESERVA=

# Reserva opcional de OUTRO provedor (não-Google), pra quando o Gemini
# inteiro (chave do usuário + as duas acima) estiver sem cota ou
# sobrecarregado. Chave(s) grátis da Groq (console.groq.com/keys, sem cartão
# de crédito) — também aceita mais de uma, separadas por vírgula ou quebra
# de linha. Totalmente opcional — sem ela, o comportamento é o mesmo de
# antes (só o Gemini).
GROQ_API_KEY=

# Reserva opcional de mais um provedor (não-Google), tentado só depois que
# Gemini e Groq falharem. Chave(s) grátis da OpenRouter (openrouter.ai/keys,
# sem cartão de crédito) — usa o "openrouter/free", o roteador oficial deles
# que sorteia entre os modelos gratuitos disponíveis no momento (evita fixar
# um modelo específico que pode sair de linha). Também aceita mais de uma
# chave, separadas por vírgula ou quebra de linha. Totalmente opcional — sem
# ela, o comportamento é o mesmo de antes.
OPENROUTER_API_KEY=

# Reserva opcional: Cerebras (cloud.cerebras.ai). Inferência muito rápida,
# tier gratuito de 1M tokens/dia e ~30 mil tokens/minuto, sem cartão. A janela
# de contexto grátis é de 8K, então ela funciona bem com os pedaços pequenos
# que o app já usa. Aceita mais de uma chave, separadas por vírgula.
CEREBRAS_API_KEY=

# Modelo da Cerebras. Opcional — o catálogo deles muda (vários modelos foram
# descontinuados em fev/2026), então deixar em variável evita mexer no código.
CEREBRAS_MODEL=

# Reserva opcional: Cohere, pelo endpoint compatível com OpenAI.
# ATENÇÃO: a chave de teste (gratuita) é limitada a ~1000 chamadas/mês e, pelos
# termos da Cohere, NÃO pode ser usada comercialmente — relevante se o app for
# publicado na Play Store. Para uso pessoal/teste, serve bem.
COHERE_API_KEY=

# Modelo da Cohere. Opcional — mesma lógica das outras.
COHERE_MODEL=
